    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst first = items[0]?.json || {};\nconst leadExists = Object.keys(first).length > 0;\nconst trigger = $('Incomming WhatsApp Message').first().json;\n\nreturn [{\n  json: {\n    leadExists,\n    contact_id: trigger.messages[0].from,\n    message: trigger.messages[0].text.body,\n    lead: leadExists ? first : null\n  }\n}];"
      },
