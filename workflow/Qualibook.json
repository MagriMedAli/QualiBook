        "query": "INSERT INTO leads (contact_id, stage, name)\nVALUES (\n  '{{ $json.contact_id }}',\n  'new',\n  '{{ $('WhatsApp Trigger').item.json.contacts[0].profile.name.replace(/'/g, \"''\") }}'\n)\nRETURNING *;",
