      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Call this tool immediately whenever the user mentions their budget, preferred area, whether they're buying or renting, or their timeline. Pass whichever fields were mentioned; leave others empty.",
        "operation": "executeQuery",
        "query": "UPDATE leads\nSET\n  budget = COALESCE(NULLIF('{{ $fromAI(\"budget\", \"the lead's budget, or empty if not mentioned\", \"string\") }}', ''), budget),\n  area = COALESCE(NULLIF('{{ $fromAI(\"area\", \"the area/neighborhood they want, or empty if not mentioned\", \"string\") }}', ''), area),\n  intent = COALESCE(NULLIF('{{ $fromAI(\"intent\", \"buying or renting, or empty if not mentioned\", \"string\") }}', ''), intent),\n  timeline = COALESCE(NULLIF('{{ $fromAI(\"timeline\", \"how soon they want to move, or empty if not mentioned\", \"string\") }}', ''), timeline),\n  stage = COALESCE(NULLIF('{{ $fromAI(\"stage\", \"new stage: qualifying, qualified, or unqualified, or empty if unchanged\", \"string\") }}', ''), stage),\n  updated_at = NOW()\nWHERE contact_id = '{{ $json.contact_id }}'\nRETURNING *;",
        "options": {}
      },
